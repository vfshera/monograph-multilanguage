---
import Layout from "~/layouts/Layout.astro";
import { getEntry, render } from "astro:content";
import { getLocale } from "i18n:astro";

const locale = getLocale();

/**
 *  we are using lower case slugs to match Entry.id
 */
let slug = Astro.url.pathname.split("/").filter(Boolean).join("/").toLowerCase();

if (!slug.startsWith(locale.toLowerCase())) {
  slug = `${locale}/${slug}`.toLowerCase();
}

const entry = await getEntry("pages", slug);

if (!entry) {
  throw new Error(`Page not found: ${Astro.url.pathname}`);
}

const { Content } = await render(entry);
const page = entry.data;

const headerLabel = page.customMetadata.headerLabel;
---

<Layout
  title={page.meta.title || page.title}
  description={page.meta.description || page.description}
>
  <div id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        {headerLabel && <p class="eyebrow">{headerLabel}</p>}
        <h1 class="pagehead-title">{page.title}</h1>
        <p class="pagehead-description">
          {page.description}
        </p>
      </header>

      <div class="prose">
        <Content />
      </div>
    </div>
  </div>
</Layout>
