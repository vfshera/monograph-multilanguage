---
import Layout from "~/layouts/Layout.astro";
import { siteConfig } from "~/config/site";
import { t } from "i18n:astro";

const contact = siteConfig.contact;
const action = contact.action.trim();
const isEnabled = contact.enabled;
---

<Layout
  title={t("contact:title")}
  description={t("contact:description", { name: siteConfig.name })}
  structuredData={[
    {
      "@type": "ContactPage",
      name: t("contact:title"),
      url: new URL(Astro.url.pathname, Astro.site).toString(),
    },
  ]}
>
  <div id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">{t("contact:eyebrow")}</p>
        <h1 class="pagehead-title">{t("contact:heading")}</h1>
        <p class="pagehead-description">
          {t("contact:body", { responseTime: contact.responseTime })}
        </p>
        {
          siteConfig.email && (
            <p class="mt-4 text-sm text-muted-foreground">
              {t("contact:form.email.prompt", { email: siteConfig.email })}{" "}
              <a
                href={`mailto:${siteConfig.email}`}
                class="text-accent underline underline-offset-2"
              >
                {siteConfig.email}
              </a>
              .
            </p>
          )
        }
      </header>

      <form
        class="grid gap-5"
        action={action || undefined}
        method={contact.method}
        id="contact-form"
      >
        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="contact-name"
            >{t("contact:form.nameLabel")}</label
          >
          <input
            id="contact-name"
            name="name"
            type="text"
            autocomplete="name"
            required
            disabled={!isEnabled}
            class="field"
          />
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="contact-email"
            >{t("contact:form.email.label")}</label
          >
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            disabled={!isEnabled}
            class="field"
          />
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="contact-message"
            >{t("contact:form.messageLabel")}</label
          >
          <textarea
            id="contact-message"
            name="message"
            rows="7"
            required
            disabled={!isEnabled}
            class="field resize-y"></textarea>
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <button type="submit" disabled={!isEnabled} class="btn btn-solid">
            {isEnabled ? t("contact:form.submit.send") : t("contact:form.submit.unavailable")}
          </button>
          <p
            class="contact-status text-sm leading-relaxed text-muted-foreground"
            role="status"
            aria-live="polite"
            data-contact-status
          >
          </p>
        </div>

        {
          !isEnabled && (
            <p class="text-sm leading-relaxed text-muted-foreground">
              {t("contact:disabledNotice")}
            </p>
          )
        }
      </form>
    </div>
  </div>
</Layout>

<script>
  import { t } from "i18n:astro";

  const form = document.getElementById("contact-form") as HTMLFormElement;

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    const status = form.querySelector("[data-contact-status]");
    if (status) {
      status.textContent = t("contact:demoMessage");
    }

    form.reset();
  });
</script>

<style>
  .contact-status:empty {
    display: none;
  }
</style>
