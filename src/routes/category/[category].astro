---
import { getCollection } from "astro:content";
import PostCard from "~/components/PostCard.astro";
import Layout from "~/layouts/Layout.astro";
import { siteConfig } from "~/config/site";

import { getDefaultLocale, getLocale, getLocalePlaceholder, t } from "i18n:astro";
import { visiblePosts } from "~/lib/posts";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const locale = getLocalePlaceholder();

  const categories = await getCollection("categories", ({ id }) => id.startsWith(locale));

  return (
    await Promise.all(
      categories.map(async (category) => {
        return {
          category,
          posts: visiblePosts(
            await getCollection("posts", (p) => p.data.category.id === `${locale}/${category.id}`),
          ),
        };
      }),
    )
  )
    .filter((i) => i.posts.length)

    .map(({ category, posts }) => ({
      params: { category: category.id },
      props: { category, posts },
    }));
}

const { category, posts } = Astro.props;
const locale = getLocale();
const defaultLocale = getDefaultLocale();
const { description, name: title } = category.data[locale] || category.data[defaultLocale];
---

<Layout
  title={title}
  description={`${description} ${siteConfig.name} posts in ${category}.`}
  structuredData={[
    {
      "@type": "CollectionPage",
      name: title,
      description,
      url: new URL(Astro.url.pathname, Astro.site!).toString(),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: Astro.site!.toString() },
        {
          "@type": "ListItem",
          position: 2,
          name: "Categories",
          item: new URL("/categories/", Astro.site!).toString(),
        },
        { "@type": "ListItem", position: 3, name: title },
      ],
    },
  ]}
>
  <div id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">{t("categories:categoryEyebrow")}</p>
        <h1 class="pagehead-title">{title}</h1>
        <p class="pagehead-description">{description}</p>
        <p class="meta mt-5">
          <span>{t("categories:postCount", { count: posts.length })}</span>
        </p>
      </header>

      <div class="feed">
        {posts.map((post) => <PostCard post={post} />)}
      </div>

      <a href="/categories/" class="btn btn-outline btn-block mt-16"
        >{t("categories:allCategories")}</a
      >
    </div>
  </div>
</Layout>
