---
import { getCollection } from "astro:content";
import { siteConfig } from "~/config/site";
import { categoryHref, visiblePosts } from "~/lib/posts";
import { t, getLocale, getDefaultLocale } from "i18n:astro";
import { getEntries } from "astro:content";
import Layout from "~/layouts/Layout.astro";

const locale = getLocale();
const defaultLocale = getDefaultLocale();
const allPosts = visiblePosts(await getCollection("posts"));

const categoryPostCount = allPosts.reduce(
  (acc, post) => {
    if (!acc[post.data.category.id]) {
      acc[post.data.category.id] = 1;
    } else {
      acc[post.data.category.id]++;
    }

    return acc;
  },
  {} as Record<string, number>,
);

const categories = await getEntries(
  Object.keys(categoryPostCount).map((id) => ({ id, collection: "categories" })),
);
---

<Layout
  title={t("categories:title")}
  description={`Every category on ${siteConfig.name}, with post counts.`}
  structuredData={[
    {
      "@type": "CollectionPage",
      name: t("categories:title"),
      description: `Every category on ${siteConfig.name}, with post counts.`,
      url: new URL(Astro.url.pathname, Astro.site!).toString(),
    },
  ]}
>
  <div id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">{t("categories:eyebrow")}</p>
        <h1 class="pagehead-title">{t("categories:title")}</h1>
        <p class="pagehead-description">
          {t("categories:postCount", { count: allPosts.length })}
          {t("categories:across", { count: categories.length })}
        </p>
      </header>

      <ul class="grid gap-7">
        {
          categories.map((c) => {
            const category = c.data[locale] || c.data[defaultLocale];

            return (
              <li class="border-b border-border pb-7 last:border-b-0">
                <a href={categoryHref(c.id)} class="link-title">
                  <span class="flex items-baseline justify-between gap-4">
                    <span class="link-title__text text-xl font-semibold tracking-tight">
                      {category.name}
                    </span>
                    <span class="pill shrink-0">
                      {t("categories:postCount", { count: categoryPostCount[c.id] ?? 0 })}
                    </span>
                  </span>
                  <span class="mt-2 block max-w-2xl text-pretty text-sm leading-relaxed text-muted-foreground">
                    {category.description}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</Layout>
