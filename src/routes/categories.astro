---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categoryDescriptions } from "@/config/categories";
import { siteConfig } from "@/config/site";
import { categoryHref, getCategoryList, visiblePosts } from "@/lib/posts";
import { t } from "i18n:astro";

const allPosts = visiblePosts(await getCollection("posts"));
const categoryList = getCategoryList(allPosts);
---

<BaseLayout
  title={t("categories:title")}
  description={`Every category on ${siteConfig.name}, with post counts.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">{t("categories:eyebrow")}</p>
        <h1 class="pagehead-title">{t("categories:title")}</h1>
        <p class="pagehead-description">
          {t("categories:postCount", { count: allPosts.length })}
          {t("categories:across", { count: categoryList.length })}
        </p>
      </header>

      <ul class="grid gap-7">
        {
          categoryList.map((category) => (
            <li class="border-b border-border pb-7 last:border-b-0">
              <a href={categoryHref(category.name)} class="link-title">
                <span class="flex items-baseline justify-between gap-4">
                  <span class="link-title__text text-xl font-semibold tracking-tight">
                    {category.name}
                  </span>
                  <span class="pill shrink-0">
                    {t("categories:postCount", { count: category.count })}
                  </span>
                </span>
                <span class="mt-2 block max-w-2xl text-pretty text-sm leading-relaxed text-muted-foreground">
                  {categoryDescriptions[category.name]}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
