---
import { getCollection } from "astro:content";
import PostCard from "~/components/PostCard.astro";
import Layout from "~/layouts/Layout.astro";
import { siteConfig } from "~/config/site";
import { visiblePosts } from "~/lib/posts";
import { t } from "i18n:astro";
import { getEntries } from "astro:content";

export async function getStaticPaths() {
  const allPosts = visiblePosts(await getCollection("posts"));

  const authors = await getEntries(allPosts.map((post) => post.data.author));

  return authors.map((a) => {
    return {
      params: { author: a.id },
      props: {
        author: { ...a.data, slug: a.id },
        posts: allPosts.filter((post) => post.data.author.id === a.id),
      },
    };
  });
}

const { author, posts } = Astro.props;
---

<Layout
  title={author.name}
  description={t("authors:post.description", {
    name: author.name,
    role: author.role,
    siteName: siteConfig.name,
  })}
  structuredData={[
    {
      "@type": "ProfilePage",
      name: author.name,
      mainEntity: {
        "@type": "Person",
        name: author.name,
        jobTitle: author.role,
        url: new URL(Astro.url.pathname, Astro.site!).toString(),
      },
    },
  ]}
>
  <div id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">{t("authors:author.eyebrow")}</p>
        <h1 class="pagehead-title">{author.name}</h1>
        <p class="pagehead-description">
          {t("authors:author.postCount", { role: author.role, count: posts.length })}
        </p>
      </header>

      <div class="feed">
        {posts.map((post) => <PostCard post={post} />)}
      </div>

      <a href="/author/" class="btn btn-outline btn-block mt-16">{t("authors:allAuthors")}</a>
    </div>
  </div>
</Layout>
