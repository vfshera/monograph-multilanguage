---
import { getCollection } from "astro:content";
import PostCard from "~/components/PostCard.astro";
import Layout from "~/layouts/Layout.astro";
import { siteConfig } from "~/config/site";
import { getAllAuthors, visiblePosts, type Post } from "~/lib/posts";
import { t } from "i18n:astro";

export async function getStaticPaths() {
  const allPosts = visiblePosts(await getCollection("posts"));
  const authorEntries = await getCollection("authors");

  return getAllAuthors(allPosts, authorEntries).map((author) => ({
    params: { author: author.slug },
    props: { author, allPosts },
  }));
}

interface Props {
  author: { slug: string; name: string; role: string; posts: Post[] };
  allPosts: Post[];
}

const { author, allPosts } = Astro.props;
const posts = visiblePosts(allPosts).filter(
  (post) => post.data.author.id === author.slug,
);
---

<Layout
  title={author.name}
  description={t("authors:postDescription", {
    name: author.name,
    role: author.role,
    siteName: siteConfig.name,
  })}
  structuredData={[
    {
      "@type": "ProfilePage",
      name: author.name,
      mainEntity: {
        "@type": "Person",
        name: author.name,
        jobTitle: author.role,
        url: new URL(Astro.url.pathname, Astro.site!).toString(),
      },
    },
  ]}
>
  <div id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">{t("authors:authorEyebrow")}</p>
        <h1 class="pagehead-title">{author.name}</h1>
        <p class="pagehead-description">
          {t("authors:authorPostCount", { role: author.role, count: posts.length })}
        </p>
      </header>

      <div class="feed">
        {posts.map((post) => <PostCard post={post} />)}
      </div>

      <a href="/author/" class="btn btn-outline btn-block mt-16">{t("authors:allAuthors")}</a>
    </div>
  </div>
</Layout>
