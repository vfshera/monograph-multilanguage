---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { siteConfig } from "@/config/site";
import { getAllAuthors, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const authors = getAllAuthors(allPosts);
---

<Layout title="Authors" description={`People who write for ${siteConfig.name}.`}>
  <div id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Index</p>
        <h1 class="pagehead-title">Authors</h1>
        <p class="pagehead-description">
          {authors.length}
          {authors.length === 1 ? "person writes" : "people write"} here.
        </p>
      </header>

      <ul class="grid gap-5">
        {
          authors.map((author) => (
            <li class="border-b border-border pb-5 last:border-b-0">
              <a
                href={`/author/${author.slug}/`}
                class="link-title flex items-baseline justify-between gap-4"
              >
                <span>
                  <span class="link-title__text block text-xl font-semibold tracking-tight">
                    {author.name}
                  </span>
                  <span class="mt-1 block text-sm text-muted-foreground">{author.role}</span>
                </span>
                <span class="pill shrink-0">
                  {author.posts.length} {author.posts.length === 1 ? "post" : "posts"}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Layout>
