---
import { getCollection } from "astro:content";
import Layout from "~/layouts/Layout.astro";
import { siteConfig } from "~/config/site";
import { getAllAuthors, visiblePosts } from "~/lib/posts";
import { t } from "i18n:astro";

const allPosts = visiblePosts(await getCollection("posts"));
const authorEntries = await getCollection("authors");
const authors = getAllAuthors(allPosts, authorEntries);
---

<Layout
  title={t("authors:title")}
  description={t("authors:description", { name: siteConfig.name })}
  structuredData={[
    {
      "@type": "CollectionPage",
      name: t("authors:title"),
      description: t("authors:description", { name: siteConfig.name }),
      url: new URL(Astro.url.pathname, Astro.site!).toString(),
    },
  ]}
>
  <div id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">{t("authors:eyebrow")}</p>
        <h1 class="pagehead-title">{t("authors:title")}</h1>
        <p class="pagehead-description">
          {t("authors:authorCount", { count: authors.length })}
        </p>
      </header>

      <ul class="grid gap-5">
        {
          authors.map((author) => (
            <li class="border-b border-border pb-5 last:border-b-0">
              <a
                href={`/author/${author.slug}/`}
                class="link-title flex items-baseline justify-between gap-4"
              >
                <span>
                  <span class="link-title__text block text-xl font-semibold tracking-tight">
                    {author.name}
                  </span>
                  <span class="mt-1 block text-sm text-muted-foreground">{author.role}</span>
                </span>
                <span class="pill shrink-0">
                  {t("authors:postCount", { count: author.posts.length })}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Layout>
