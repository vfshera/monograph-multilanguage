---
import { siteConfig } from "@/config/site";
import "@/styles/global.css";
import I18nHead from "@astrolicious/i18n/components/I18nHead.astro";
import I18nClient from "@astrolicious/i18n/components/I18nClient.astro";
import { getHtmlAttrs } from "i18n:astro";
import { SEO, type Props as AstroSEOProps } from "astro-seo";

interface Props extends AstroSEOProps {
  /**
   * Applied to html body
   */
  class?: astroHTML.JSX.HTMLAttributes["class"];
  /**
   * Applied to html body
   */
  "class:list"?: astroHTML.JSX.HTMLAttributes["class:list"];
}

const { title, description, class: className, "class:list": classList, ...props } = Astro.props;

const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
---

<!doctype html>
<html {...getHtmlAttrs()} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href="/fonts/geist/Geist-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} RSS`}
      href={new URL("/rss.xml", siteConfig.siteUrl).toString()}
    />

    <SEO
      title={title}
      titleDefault={siteConfig.title}
      titleTemplate={`%s - ${siteConfig.title}`}
      description={description || siteConfig.description}
      {...props}
    />

    <I18nClient />
    <I18nHead />
    <script is:inline>
      /*
       * Runs before first paint so the stored reading mode is applied without a
       * flash. Falls back to the system preference until the reader picks a side.
       */
      (() => {
        const storageKey = "monograph-theme";
        const root = document.documentElement;
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
        let storedTheme;

        try {
          storedTheme = localStorage.getItem(storageKey);
        } catch {
          storedTheme = null;
        }

        const updateToggles = (theme) => {
          const isDark = theme === "dark";
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.setAttribute("aria-checked", String(isDark));
            button.setAttribute(
              "aria-label",
              isDark ? "Switch to light mode" : "Switch to dark mode",
            );
          });
        };

        const setTheme = (theme, persist = false) => {
          root.dataset.theme = theme;
          if (persist) {
            storedTheme = theme;
            try {
              localStorage.setItem(storageKey, theme);
            } catch {}
          }
          updateToggles(theme);
        };

        const preferredTheme =
          storedTheme === "light" || storedTheme === "dark"
            ? storedTheme
            : systemDark.matches
              ? "dark"
              : "light";

        setTheme(preferredTheme);

        systemDark.addEventListener("change", (event) => {
          if (storedTheme === "light" || storedTheme === "dark") return;
          setTheme(event.matches ? "dark" : "light");
        });

        window.addEventListener("DOMContentLoaded", () => {
          updateToggles(root.dataset.theme || preferredTheme);
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.addEventListener("click", () => {
              setTheme(root.dataset.theme === "dark" ? "light" : "dark", true);
            });
          });
        });
      })();
    </script>
  </head>
  <body class:list={[classList, className]}>
    <slot />
  </body>
</html>
