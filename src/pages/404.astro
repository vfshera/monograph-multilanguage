---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Page not found" description="The page you requested could not be found." noindex>
  <div id="content" class="outer grid min-h-[55vh] place-items-center py-16 text-center">
    <div>
      <p class="eyebrow">Error 404</p>
      <h1 class="pagehead-title">Page not found</h1>
      <p class="pagehead-description mx-auto">
        That post may have moved, or the address may be mistyped.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="btn btn-solid">Back to the front page</a>
        <a href="/posts/" class="btn btn-outline">Browse the archive</a>
      </div>
    </div>
  </div>
</Layout>
